# =====================================================================
# Variáveis de ambiente — copie para .env e ajuste os valores.
# Nunca commitar o .env real. Ver .specs/01-arquitetura/overview.md §4.
# =====================================================================

# --- PostgreSQL (serviço `db` do docker-compose) ---
POSTGRES_USER=guia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guia

# --- API ---
# Dentro do Docker Compose o host é o serviço `db`:
DATABASE_URL=postgresql://guia:change-me@db:5432/guia?schema=public
# Para rodar o backend fora do Docker (npm run start:dev), use localhost:
# DATABASE_URL=postgresql://guia:change-me@localhost:5433/guia?schema=public

PORT=3000

# JWT (access curto + refresh) — gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Origem do PWA (usada para CORS e links absolutos)
# Em produção use a origem pública: https://meudominio.com
APP_BASE_URL=http://localhost:8081

# --- Deploy (VPS com Traefik) ---
# Domínio público da aplicação — usado nas labels do Traefik (router + TLS).
# Interpolado pelo compose: suba com
#   docker compose --env-file .env -f docker/docker-compose.yml up -d --build
# Em dev local pode omitir (default: localhost).
# APP_DOMAIN=meudominio.com

# Usuário ADMIN inicial (criado pelo seed do Prisma; upsert idempotente por email)
SEED_ADMIN_EMAIL=admin@guia.local
SEED_ADMIN_PASSWORD=change-me-min-8-chars

# --- Gamificação / ranking (Fase 2) ---
# Constantes da fórmula de pontuação (defaults no código):
# PTS_SUBTEMA=10
# PTS_HORA=5
# PTS_BONUS_SEM=50
# Cron da recomputação do ranking (default: de hora em hora).
# Interpretado no timezone do PROCESSO (UTC no container):
# ex.: "0 3 * * *" = 3h UTC = 0h em Brasília.
# RANKING_CRON=0 * * * *
# Desabilita o scheduler e a execução de boot (útil em testes/dev):
# RANKING_CRON_DISABLED=true

# --- Hotmart (Fase 2 — webhook de provisionamento de acesso) ---
# HOTMART_HOTTOK=change-me
